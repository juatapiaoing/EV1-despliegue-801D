# Configuracion de Lombok para todo el proyecto.
config.stopBubbling = true

# Marca con @lombok.Generated el codigo que Lombok genera (getters, setters,
# builders, equals...). JaCoCo ignora los metodos con esa anotacion, de modo que
# la cobertura mide solo el codigo escrito a mano.
lombok.addLombokGeneratedAnnotation = true
